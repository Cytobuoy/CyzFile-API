<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CytoSense</RootNamespace>
    <AssemblyName>CyzFile</AssemblyName>
	<ProductName>CyzFile</ProductName>
	<ProjectName>CyzFile</ProjectName>
	
	<TargetFrameworks>net10.0</TargetFrameworks>
    <OutputPath>$(BaseOutputPath)\$(Platform)\$(Configuration)</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)\$(Platform)\$(Configuration)</IntermediateOutputPath>
    <Configurations>Debug;Release;ReleaseErnie;ReleaseWebsite</Configurations>
    <Platforms>AnyCPU;x64</Platforms>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
	
    <FileVersion>1.8.0.0</FileVersion>
    <AssemblyVersion>$(FileVersion)</AssemblyVersion>
  </PropertyGroup>


  <ItemGroup>
	  <PackageReference Include="log4net" Version="3.5.0" />
	  <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
	  <PackageReference Include="OpenCvSharp4" version="4.13.0.20260627" />
	  <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
	  <PackageReference Include="OpenCvSharp4.runtime.win" version="4.13.0.20260627" />
	  <PackageReference Include="OpenCvSharp4.Windows" version="4.13.0.20260627" />
	  <PackageReference Include="OpenCvSharp4.WpfExtensions" version="4.13.0.20260627" />
	  <PackageReference Include="System.Drawing.Common" version="10.0.14" />
	  <PackageReference Include="System.IO.Ports" Version="10.0.14" />
	  <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.14" />
	  <PackageReference Include="UnitsNet" Version="5.75.1" />
  </ItemGroup>


  <ItemGroup>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project\Settings.Designer.vb">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>


  <ItemGroup>
    <None Update="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="My Project\Resources.resx">
			<CustomToolNamespace>My.Resources</CustomToolNamespace>
			<Generator>VbMyResourcesResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.vb</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<Resource Include="icons/**/*.*" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="My Project\Resources.Designer.vb">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>


  <Target Name="CyzFileGetVersionInfo" BeforeTargets="PrepareForBuild">
	<Exec Command="git describe --always --long --dirty" ConsoleToMsBuild="True">
		<Output TaskParameter="ConsoleOutput" PropertyName="GitVersionStuff" />
	</Exec>

	<CreateProperty Value="$(GitVersionStuff)">
		<Output PropertyName="InformationalVersion" TaskParameter="Value" />
	</CreateProperty>
	<CreateProperty Value="$(GitVersionStuff)">
		<Output PropertyName="Description" TaskParameter="Value" />
	</CreateProperty>

  </Target>


</Project>
